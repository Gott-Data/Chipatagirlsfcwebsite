# Copy this file to `.env` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# --- Stripe ---
# Publishable key from https://dashboard.stripe.com/apikeys (safe to ship in browser).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe Payment Link for donations.
# Create one at https://dashboard.stripe.com/payment-links — this is the
# simplest path to taking donations without running a backend. Enable
# "Let customers choose what to pay" so a single link handles every tier.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/replace_me

# Optional: individual links per tier. If set, these override the generic
# link above for that specific preset. Leave blank to use the generic link.
VITE_STRIPE_PAYMENT_LINK_25=
VITE_STRIPE_PAYMENT_LINK_50=
VITE_STRIPE_PAYMENT_LINK_100=
VITE_STRIPE_PAYMENT_LINK_250=
VITE_STRIPE_PAYMENT_LINK_500=

# --- Contact ---
# Public-facing email shown in the footer and on the Contact page.
VITE_CONTACT_EMAIL=info@chipatagirlsfc.org
VITE_CONTACT_PHONE=+260 XXX XXX XXX
VITE_FACEBOOK_URL=https://www.facebook.com/p/Chipata-Girls-FC-61554761447142/
